{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    {
      "name": "windows-vs2022",
      "displayName": "Windows - Visual Studio 2022 (x64)",
      "inherits": "base",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    },
    {
      "name": "macos-xcode",
      "displayName": "macOS - Xcode (Apple silicon)",
      "inherits": "base",
      "generator": "Xcode",
      "cacheVariables": {
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "14.0"
      },
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Darwin" }
    }
  ],
  "buildPresets": [
    { "name": "windows-debug",   "configurePreset": "windows-vs2022", "configuration": "Debug" },
    { "name": "windows-release", "configurePreset": "windows-vs2022", "configuration": "Release" },
    { "name": "macos-debug",     "configurePreset": "macos-xcode",    "configuration": "Debug" },
    { "name": "macos-release",   "configurePreset": "macos-xcode",    "configuration": "Release" }
  ],
  "testPresets": [
    { "name": "windows-debug",   "configurePreset": "windows-vs2022", "configuration": "Debug",   "output": { "outputOnFailure": true } },
    { "name": "windows-release", "configurePreset": "windows-vs2022", "configuration": "Release", "output": { "outputOnFailure": true } },
    { "name": "macos-debug",     "configurePreset": "macos-xcode",    "configuration": "Debug",   "output": { "outputOnFailure": true } },
    { "name": "macos-release",   "configurePreset": "macos-xcode",    "configuration": "Release", "output": { "outputOnFailure": true } }
  ],
  "packagePresets": [
    { "name": "windows-release", "configurePreset": "windows-vs2022", "configurations": [ "Release" ], "generators": [ "ZIP" ], "packageDirectory": "${sourceDir}/build/packages" },
    { "name": "macos-release",   "configurePreset": "macos-xcode",    "configurations": [ "Release" ], "generators": [ "ZIP" ], "packageDirectory": "${sourceDir}/build/packages" }
  ],
  "workflowPresets": [
    {
      "name": "windows-release",
      "steps": [
        { "type": "configure", "name": "windows-vs2022" },
        { "type": "build",     "name": "windows-release" },
        { "type": "test",      "name": "windows-release" },
        { "type": "package",   "name": "windows-release" }
      ]
    },
    {
      "name": "macos-release",
      "steps": [
        { "type": "configure", "name": "macos-xcode" },
        { "type": "build",     "name": "macos-release" },
        { "type": "test",      "name": "macos-release" },
        { "type": "package",   "name": "macos-release" }
      ]
    }
  ]
}
