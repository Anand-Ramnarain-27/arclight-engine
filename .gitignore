# Commit source and build inputs; never build output, per-user IDE state or captures.

# --- Build output (CMake presets write to build/) ---
/build/
/out/

# --- CMake ---
CMakeUserPresets.json
CMakeCache.txt
CMakeFiles/
cmake-build-*/

# --- Visual Studio ---
.vs/
*.user
*.suo
*.aps
*.VC.db
*.VC.opendb
ipch/

# --- Xcode / macOS ---
DerivedData/
xcuserdata/
*.xcuserstate
.DS_Store

# --- Editors ---
# Shared VS Code settings may be committed; everything else in .vscode/ is per-user.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp

# --- Runtime output ---
*.log
imgui.ini

# --- GPU captures (PIX, RenderDoc, Xcode) ---
Captures/
*.wpix
*.rdc
*.gputrace
